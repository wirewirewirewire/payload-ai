    "yalc:deploy": "yarn  build && yalc publish --push",
    "lint:fix": "eslint --fix --ext .ts,.tsx src",
    "clean": "rimraf dist && rimraf dev-v3/yarn.lock",
    "prepublishOnly": "yarn clean && yarn build && cd dev-v3",
    "copyfiles": "copyfiles -u 1 \"./src/**/*/*.scss\" dist"
  },
